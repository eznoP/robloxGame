-- Índice bioma -> árvores (montado uma vez para o spawner).
local ByBiome: { [Types.BiomeId]: { Types.TreeId } } = {}
for id, config in Configs do
	for _, biome in config.biomeWhitelist do
		local list = ByBiome[biome]
		if not list then
			list = {}
			ByBiome[biome] = list
		end
		table.insert(list, id)
	end
end

return {
	Configs = Configs,
	ByBiome = ByBiome,
}
